{
  "name": "awqat",
  "private": true,
  "version": "0.19.1",
  "description": "Awqat, the Muslim personal OS: a calm life app that runs on the five prayer times, for Android, iPhone and iPad.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "TZ=Asia/Dubai vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capgo/capacitor-health": "8.11.12",
    "@elevenlabs/client": "1.26.0",
    "@huggingface/transformers": "4.2.0",
    "adhan": "4.4.6",
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "onnxruntime-node": "file:./stubs/onnxruntime-node",
    "sharp": "file:./stubs/sharp"
  }
