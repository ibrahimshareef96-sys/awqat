<?xml version="1.0" encoding="utf-8"?>
<!-- The next meeting, 4 x 2: when it is beside the label, its title in the serif, then the prayer before it and the one
     after it. About 100dp at normal font size, so a larger font still fits the 110dp it starts at. Home screen only:
     a meeting's title is private, so this widget never goes on the lock screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/agenda_label"
            style="@style/WidgetLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/agenda_widget_caps" />

        <TextView
            android:id="@+id/agenda_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="Today 15:00"
            android:textColor="#E2CC9A"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/agenda_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="2"
        android:text="Study circle"
        android:textColor="#ECE6D8"
        android:textSize="18sp" />

    <FrameLayout
        android:id="@+id/agenda_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#26FFFFFF" />

    <LinearLayout
        android:id="@+id/agenda_prayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetLabel"
                android:text="@string/agenda_before" />

            <TextView
                android:id="@+id/agenda_before"
                style="@style/WidgetLine"
                android:text="Dhuhr 12:06" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetLabel"
                android:text="@string/agenda_after" />

            <TextView
                android:id="@+id/agenda_after"
                style="@style/WidgetLine"
                android:text="Asr 15:22" />
        </LinearLayout>
    </LinearLayout>

    <!-- In place of the prayers while the place is only guessed. -->
    <TextView
        android:id="@+id/agenda_note"
        style="@style/WidgetLine"
        android:text="@string/widget_set_place"
        android:textColor="#ADECE6D8"
        android:visibility="gone" />
</LinearLayout>
