<?xml version="1.0" encoding="utf-8"?>
<!-- The widget given 130dp of height or more: the next prayer in a serif with its countdown beside the label, then the
     page and today's revision (about 105dp at normal font size, so a larger font still fits), and from 150dp the steps.
     Only views RemoteViews allows (LinearLayout, FrameLayout, TextView, Chronometer); the hairline is a FrameLayout. The
     system serif, because a launcher draws widget text with system fonts only (the app's Instrument Serif showed as the
     default sans on the emulator). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/widget_prayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.22"
                android:singleLine="true"
                android:text="@string/widget_next_prayer"
                android:textColor="#ADECE6D8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Ticks by itself in the launcher: a system timer with no updates from the app. -->
            <Chronometer
                android:id="@+id/widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="#E2CC9A"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- The prayer and its time on one line (the time's colour is set in code); cut from the start, so the time
             always shows. -->
        <TextView
            android:id="@+id/widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:fontFamily="serif"
            android:singleLine="true"
            android:text="Asr  15:22"
            android:textColor="#ECE6D8"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#26FFFFFF" />

    <TextView
        android:id="@+id/widget_quran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="Page 313 of 604"
        android:textColor="#E6ECE6D8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_revise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="Revise Juz 12"
        android:textColor="#ADECE6D8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textColor="#ADECE6D8"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
