<?xml version="1.0" encoding="utf-8"?>
<!-- The Quran, 2 x 2: the page to read on in the serif, today's pages against the goal, and today's revision when there
     is a plan (about 100dp at normal font size, so a larger font still fits the 110dp it starts at). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quran_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/quran_label"
        style="@style/WidgetLabel"
        android:text="@string/quran_widget_caps" />

    <TextView
        android:id="@+id/quran_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="2"
        android:text="Page 313 of 604"
        android:textColor="#ECE6D8"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/quran_read"
        style="@style/WidgetLine"
        android:layout_marginTop="4dp"
        android:text="2 of 5 pages today" />

    <TextView
        android:id="@+id/quran_revise"
        style="@style/WidgetLine"
        android:text="Revise Juz 12"
        android:textColor="#ADECE6D8" />
</LinearLayout>
