<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: everything the app calls is https, and nothing it reaches needs plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
