<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Talk, Adhkar and Read Quran on a long press of the icon: awqat://go/<screen> links, checked as a widget's. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- The home-screen widget. Its only inputs are the snapshot the app saves and these broadcasts, each of which
             just redraws it from that snapshot. Not exported: the system still delivers its own broadcasts, and no other
             app can reach it. -->
        <receiver
            android:name=".TodayWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- The dhikr counter. A tap comes back to it as its own broadcast, through a PendingIntent this app made; not
             exported, so nothing else can count. -->
        <receiver
            android:name=".DhikrWidget"
            android:exported="false"
            android:label="@string/dhikr_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dhikr_info" />
        </receiver>

        <!-- The prayer day, the Quran, the adhkar and the next meeting. As TodayWidget: their only inputs are the snapshot
             and these broadcasts, each of which only redraws from it; not exported. -->
        <receiver
            android:name=".PrayerDayWidget"
            android:exported="false"
            android:label="@string/prayer_day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_day_info" />
        </receiver>

        <receiver
            android:name=".QuranWidget"
            android:exported="false"
            android:label="@string/quran_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quran_info" />
        </receiver>

        <receiver
            android:name=".AdhkarWidget"
            android:exported="false"
            android:label="@string/adhkar_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_adhkar_info" />
        </receiver>

        <!-- Home screen only (widget_agenda_info.xml): a meeting's title never goes on the lock screen. -->
        <receiver
            android:name=".AgendaWidget"
            android:exported="false"
            android:label="@string/agenda_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>

        <!-- One tap to Talk. Drawn once; nothing in it changes. -->
        <receiver
            android:name=".TalkWidget"
            android:exported="false"
            android:label="@string/talk_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_talk_info" />
        </receiver>

        <!-- "Talk to Awqat" in Quick Settings. Exported, as the system binds it, but only a holder of the system's
             BIND_QUICK_SETTINGS_TILE permission can; it only opens the app on a fixed, checked link. -->
        <service
            android:name=".TalkTileService"
            android:exported="true"
            android:icon="@drawable/ic_talk"
            android:label="@string/talk_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- The "+1" on the live dhikr card, and the swipe that dismisses a live card. Only this app's own PendingIntents
             reach it. -->
        <receiver
            android:name=".LiveReceiver"
            android:exported="false" />

        <!-- The scanner reads barcodes with ZXing; ML Kit ships inside it but is never started, so it reports nothing. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- City-level location only: prayer times follow you without a precise position. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- The camera is for book covers and barcodes; a device without one can still type books in. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Prayer reminders are the alarm this app exists for: exact without asking on Android 13+. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The live cards: the iqama countdown, a dhikr, a timer. The second is not asked for at run time; it only lets
         Android 16 promote them to Live Updates, which the user can turn off per app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Talk: the web view asks for the microphone when a talk starts (Capacitor's BridgeWebChromeClient requests both);
         a device without one can still use everything else. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Body reads four kinds from Health Connect and writes none. The health plugin declares many more (read and
         write); every one Body does not use is removed here, so Health Connect can never offer them. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />
</manifest>
